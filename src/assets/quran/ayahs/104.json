{"surahNumber":104,"isPlaceholder":false,"ayahs":[{"ayahNumber":1,"juzNumber":30,"arabic":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ","latin":"Wailul likulli humazatil-lumazah(tin).","translation":"Celakalah setiap pengumpat lagi pencela"},{"ayahNumber":2,"juzNumber":30,"arabic":" ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ","latin":"Allażī jama‘a mālaw wa ‘addadah(ū).","translation":"yang mengumpulkan harta dan menghitung-hitungnya."},{"ayahNumber":3,"juzNumber":30,"arabic":"يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ","latin":"Yaḥsabu anna mālahū akhladah(ū).","translation":"Dia (manusia) mengira bahwa hartanya dapat mengekalkannya."},{"ayahNumber":4,"juzNumber":30,"arabic":"كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ","latin":"Kallā layumbażanna fil-ḥuṭamah(ti).","translation":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah."},{"ayahNumber":5,"juzNumber":30,"arabic":"وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ","latin":"Wa mā adrāka mal-ḥuṭamah(tu).","translation":"Tahukah kamu apakah (neraka) Hutamah?"},{"ayahNumber":6,"juzNumber":30,"arabic":"نَارُ اللّٰهِ الْمُوْقَدَةُۙ","latin":"Nārullāhil-mūqadah(tu).","translation":"(Ia adalah) api (azab) Allah yang dinyalakan"},{"ayahNumber":7,"juzNumber":30,"arabic":"الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ","latin":"Allatī taṭṭali‘u ‘alal-af'idah(ti).","translation":"yang (membakar) naik sampai ke hati."},{"ayahNumber":8,"juzNumber":30,"arabic":"اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ","latin":"Innahā ‘alaihim mu'ṣadah(tun).","translation":"Sesungguhnya dia (api itu) tertutup rapat (sebagai hukuman) atas mereka,"},{"ayahNumber":9,"juzNumber":30,"arabic":"فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ","latin":"Fī ‘amadim mumaddadah(tin).","translation":"(sedangkan mereka) diikat pada tiang-tiang yang panjang."}]}
