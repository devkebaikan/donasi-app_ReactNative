{"surahNumber":101,"isPlaceholder":false,"ayahs":[{"ayahNumber":1,"juzNumber":30,"arabic":"اَلْقَارِعَةُۙ","latin":"Al-qāri‘ah(tu).","translation":"Al-Qāri‘ah (hari Kiamat yang menggetarkan)."},{"ayahNumber":2,"juzNumber":30,"arabic":"مَا الْقَارِعَةُ ۚ","latin":"Mal-qāri‘ah(tu).","translation":"Apakah al-Qāri‘ah itu?"},{"ayahNumber":3,"juzNumber":30,"arabic":"وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ","latin":"Wa mā adrāka mal-qāri‘ah(tu).","translation":"Tahukah kamu apakah al-Qāri‘ah itu?"},{"ayahNumber":4,"juzNumber":30,"arabic":"يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","latin":"Yauma yakūnun-nāsu kal-farāsyil-mabṡūṡ(i).","translation":"Pada hari itu manusia seperti laron yang beterbangan"},{"ayahNumber":5,"juzNumber":30,"arabic":"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ","latin":"Wa takūnul-jibālu kal-‘ihnil-manfūsy(i).","translation":"dan gunung-gunung seperti bulu yang berhamburan."},{"ayahNumber":6,"juzNumber":30,"arabic":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗۙ ","latin":"Fa ammā man ṡaqulat mawāzīnuh(ū).","translation":"Siapa yang berat timbangan (kebaikan)-nya,"},{"ayahNumber":7,"juzNumber":30,"arabic":"فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ","latin":"Fa huwa fī ‘īsyatir rāḍiyah(tin).","translation":"dia berada dalam kehidupan yang menyenangkan."},{"ayahNumber":8,"juzNumber":30,"arabic":"وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ","latin":"Wa ammā man khaffat mawāzīnuh(ū).","translation":"Adapun orang yang ringan timbangan (kebaikan)-nya,"},{"ayahNumber":9,"juzNumber":30,"arabic":"فَاُمُّهٗ هَاوِيَةٌ  ۗ","latin":"Fa ummuhū hāwiyah(tun).","translation":"tempat kembalinya adalah (neraka) Hawiyah."},{"ayahNumber":10,"juzNumber":30,"arabic":"وَمَآ اَدْرٰىكَ مَا هِيَهْۗ","latin":"Wa mā adrāka mā hiyah.","translation":"Tahukah kamu apakah (neraka Hawiyah) itu?"},{"ayahNumber":11,"juzNumber":30,"arabic":"نَارٌ حَامِيَةٌ ࣖ","latin":"Nārun ḥāmiyah(tun).","translation":"(Ia adalah) api yang sangat panas."}]}
