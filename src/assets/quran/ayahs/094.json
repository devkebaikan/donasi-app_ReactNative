{"surahNumber":94,"isPlaceholder":false,"ayahs":[{"ayahNumber":1,"juzNumber":30,"arabic":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","latin":"Alam nasyraḥ laka ṣadrak(a).","translation":"Bukankah Kami telah melapangkan dadamu (Nabi Muhammad),"},{"ayahNumber":2,"juzNumber":30,"arabic":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","latin":"Wa waḍa‘nā ‘anka wizrak(a).","translation":"meringankan beban (tugas-tugas kenabian) darimu"},{"ayahNumber":3,"juzNumber":30,"arabic":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ","latin":"Allażī anqaḍa ẓahrak(a).","translation":"yang memberatkan punggungmu,"},{"ayahNumber":4,"juzNumber":30,"arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَۗ","latin":"Wa rafa‘nā laka żikrak(a).","translation":"dan meninggikan (derajat)-mu (dengan selalu) menyebut-nyebut (nama)-mu?"},{"ayahNumber":5,"juzNumber":30,"arabic":"فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ","latin":"Fa'inna ma‘al-‘usri yusrā(n).","translation":"Maka, sesungguhnya beserta kesulitan ada kemudahan."},{"ayahNumber":6,"juzNumber":30,"arabic":"اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ","latin":"Inna ma‘al-‘usri yusrā(n).","translation":"Sesungguhnya beserta kesulitan ada kemudahan."},{"ayahNumber":7,"juzNumber":30,"arabic":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","latin":"Fa iżā faragta fanṣab.","translation":"Apabila engkau telah selesai (dengan suatu kebajikan), teruslah bekerja keras (untuk kebajikan yang lain)"},{"ayahNumber":8,"juzNumber":30,"arabic":"وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ","latin":"Wa ilā rabbika fargab.","translation":"dan hanya kepada Tuhanmu berharaplah!"}]}
