{"surahNumber":107,"isPlaceholder":false,"ayahs":[{"ayahNumber":1,"juzNumber":30,"arabic":"اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِۗ","latin":"Ara'aital-lażī yukażżibu bid-dīn(i).","translation":"Tahukah kamu (orang) yang mendustakan agama?"},{"ayahNumber":2,"juzNumber":30,"arabic":"فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَۙ","latin":"Fa żālikal-lażī yadu‘‘ul-yatīm(a).","translation":"Itulah orang yang menghardik anak yatim"},{"ayahNumber":3,"juzNumber":30,"arabic":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْكِيْنِۗ","latin":"Wa lā yaḥuḍḍu ‘alā ṭa‘āmil-miskīn(i).","translation":"dan tidak menganjurkan untuk memberi makan orang miskin."},{"ayahNumber":4,"juzNumber":30,"arabic":"فَوَيْلٌ لِّلْمُصَلِّيْنَۙ","latin":"Fawailul lil-muṣallīn(a).","translation":"Celakalah orang-orang yang melaksanakan salat,"},{"ayahNumber":5,"juzNumber":30,"arabic":"الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَۙ","latin":"Allażīna hum ‘an ṣalātihim sāhūn(a).","translation":"(yaitu) yang lalai terhadap salatnya,"},{"ayahNumber":6,"juzNumber":30,"arabic":"الَّذِيْنَ هُمْ يُرَاۤءُوْنَۙ","latin":"Allażīna hum yurā'ūn(a).","translation":"yang berbuat riya,"},{"ayahNumber":7,"juzNumber":30,"arabic":"وَيَمْنَعُوْنَ الْمَاعُوْنَ ࣖ","latin":"Wa yamna‘ūnal-mā‘ūn(a).","translation":"dan enggan (memberi) bantuan."}]}
