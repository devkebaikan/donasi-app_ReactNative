    "quran:data": "node scripts/build-quran-data.mjs",
    "map:data": "node scripts/build-map-data.mjs",
    "font:check": "node scripts/check-arabic-font.mjs"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/blur": "^4.4.1",
    "@react-navigation/bottom-tabs": "^7.18.4",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.3.10",
    "@solar-icons/react-native": "^1.1.1",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.7.9",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
